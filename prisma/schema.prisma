// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth.js (NextAuth v5) Prisma adapter models ----
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  dailyTarget   DailyTarget?
  mealEntries   MealEntry[]
  chatMessages  ChatMessage[]
  trainingEntries TrainingEntry[]
  recoveryEntries RecoveryEntry[]
  moodEntries   MoodEntry[]
  measurements   Measurement[]
  profile        UserProfile?
  telegramChat  TelegramChat?
  telegramLinkToken TelegramLinkToken?
  deviceTokens  DeviceToken[]
  weeklyCheckIns WeeklyCheckIn[]
}

// The weekly review: am I fatter or thinner, stronger or weaker, how am I
// sleeping, how am I feeling. Four questions the user answers in their own
// words — the app never substitutes a computed number for a judgement the
// person can make directly.
//
// Every answer stores the verbatim text beside it, the same receipts rule the
// pillar tables follow: a summary the user never said is a fabrication.
model WeeklyCheckIn {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Monday-anchored, from startOfWeek() — one review per person per week.
  weekOf   DateTime

  bodyAnswer         String?
  bodySourceText     String?
  strengthAnswer     String?
  strengthSourceText String?
  sleepAnswer        String?
  sleepSourceText    String?
  moodAnswer         String?
  moodSourceText     String?

  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, weekOf])
  @@index([userId])
}

// One row per installed app instance. Registering a token IS the opt-in:
// the iOS toggle registers on grant and deletes on revoke, so a user with no
// rows receives nothing. A user may have several (phone, iPad, reinstall).
model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @default("ios")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model DailyTarget {
  id        String   @id @default(cuid())
  userId    String   @unique
  calories  Int
  protein   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealEntry {
  id            String   @id @default(cuid())
  userId        String
  photoUrl      String
  foodItems     String
  totalCalories Int
  totalProtein Int
  confirmed     Boolean  @default(false)
  source        String   @default("manual")
  sourceText    String?
  loggedAt      DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainingEntry {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  minutes   Int?
  steps     Int?
  note      String?
  source    String   @default("manual")
  sourceText String?
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryEntry {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  value     Float
  source    String   @default("manual")
  sourceText String?
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  note      String?
  source    String   @default("manual")
  sourceText String?
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Measurement {
  id           String   @id @default(cuid())
  userId       String
  weightLb     Float?
  waistIn      Float?
  source       String   @default("manual")
  sourceText   String?
  measuredAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramChat {
  id        String   @id @default(cuid())
  chatId    String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TelegramLinkToken {
  token     String   @id
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  equipment String?
  notes     String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
