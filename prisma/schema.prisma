// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth.js (NextAuth v5) Prisma adapter models ----
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// IANA zone reported by the phone, e.g. "Europe/London". Decides when this
  /// user's day begins — which is when their daily caps reset and what the
  /// rings on Today measure. Null until a client reports one, and the app-wide
  /// APP_TIMEZONE stands in until then.
  timezone      String?
  accounts      Account[]
  sessions      Session[]
  dailyTarget   DailyTarget?
  mealEntries   MealEntry[]
  chatMessages  ChatMessage[]
  trainingEntries TrainingEntry[]
  recoveryEntries RecoveryEntry[]
  moodEntries   MoodEntry[]
  measurements   Measurement[]
  profile        UserProfile?
  telegramChat  TelegramChat?
  telegramLinkToken TelegramLinkToken?
  deviceTokens  DeviceToken[]
  weeklyCheckIns WeeklyCheckIn[]
  usageEvents   UsageEvent[]
  attestedDevices AttestedDevice[]
  contentReports  ContentReport[]
  subscription    Subscription?
}

// An App Attest key that Apple has vouched for: proof that a request came from
// a genuine, unmodified instance of this app on real Apple hardware.
//
// A bearer token alone proves someone once signed in; it says nothing about
// what is making the request now. Attestation is what stops a leaked token
// being replayed from a script.
model AttestedDevice {
  id        String   @id @default(cuid())
  keyId     String   @unique
  // Base64 SPKI of the key Apple attested. Text because it exceeds the
  // default varchar on some providers.
  publicKey String   @db.Text
  // Apple increments this per assertion. It must strictly increase, which is
  // what makes a captured assertion useless a second time.
  signCount Int      @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([userId])
}

// One row per billable model call, written after the gate passes.
//
// The chat cap previously counted ChatMessage rows, which undercounts: a reply
// costs two model calls, and the vision path writes no chat row at all. Photo
// analysis in particular left no trace unless the user confirmed the meal, so
// the abuse that mattered — analyse repeatedly, never save — was invisible.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'chat' | 'vision'. A bare string, like every other kind column here.
  kind      String
  createdAt DateTime @default(now())

  // What the call actually cost, filled in after it returns. Nullable because
  // the row is written BEFORE the call — a timeout still has to count — and
  // because every row written before this existed has no tokens to report.
  //
  // Recorded rather than assumed: the per-call costs the caps are sized
  // against were estimates nobody had ever checked, and a spend ceiling
  // computed from the same estimate would inherit the same error.
  inputTokens  Int?
  outputTokens Int?

  @@index([userId, kind, createdAt])
  // The spend ceiling sums a month per user across both kinds.
  @@index([userId, createdAt])
}

// The weekly review: am I fatter or thinner, stronger or weaker, how am I
// sleeping, how am I feeling. Four questions the user answers in their own
// words — the app never substitutes a computed number for a judgement the
// person can make directly.
//
// Every answer stores the verbatim text beside it, the same receipts rule the
// pillar tables follow: a summary the user never said is a fabrication.
model WeeklyCheckIn {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Monday-anchored, from startOfWeek() — one review per person per week.
  weekOf   DateTime

  bodyAnswer         String?
  bodySourceText     String?
  strengthAnswer     String?
  strengthSourceText String?
  sleepAnswer        String?
  sleepSourceText    String?
  moodAnswer         String?
  moodSourceText     String?

  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, weekOf])
  @@index([userId])
}

// One row per installed app instance. Registering a token IS the opt-in:
// the iOS toggle registers on grant and deletes on revoke, so a user with no
// rows receives nothing. A user may have several (phone, iPad, reinstall).
model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @default("ios")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model DailyTarget {
  id        String   @id @default(cuid())
  userId    String   @unique
  calories  Int
  protein   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealEntry {
  id            String   @id @default(cuid())
  userId        String
  photoUrl      String
  foodItems     String
  totalCalories Int
  totalProtein Int
  confirmed     Boolean  @default(false)
  source        String   @default("manual")
  sourceText    String?
  loggedAt      DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainingEntry {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  minutes   Int?
  steps     Int?
  note      String?
  // JSON array of {name, sets?, reps?, weightLb?}, the same shape-in-a-column
  // approach MealEntry.foodItems uses. A session is a list of exercises far
  // more often than it is a single duration, and "squats 3x8 at 185" is
  // useless to a coach once it has been flattened to "resistance, 45 min".
  exercises String?
  source    String   @default("manual")
  sourceText String?
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryEntry {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  value     Float
  source    String   @default("manual")
  sourceText String?
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  note      String?
  source    String   @default("manual")
  sourceText String?
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Measurement {
  id           String   @id @default(cuid())
  userId       String
  weightLb     Float?
  waistIn      Float?
  source       String   @default("manual")
  sourceText   String?
  measuredAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramChat {
  id        String   @id @default(cuid())
  chatId    String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TelegramLinkToken {
  token     String   @id
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A coach reply the user flagged as objectionable.
//
// Guideline 1.2 expects an app showing generated content to offer a way to
// report it. Nothing here is published to anyone else, so this is not
// moderation of a feed — it is a record of the model saying something it
// should not have, which is worth having regardless of the guideline.
model ContentReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The reported text is copied, not referenced: deleting the conversation, or
  // the account, must not erase the evidence of what was reported before it is
  // read. It cascades with the user, which is the deletion that has to win.
  messageId String?
  content   String   @db.Text
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model UserProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  equipment String?
  notes     String?
  // Height, unlike weight, does not change — so it belongs to the profile
  // rather than being a Measurement event. Used once, to estimate a starting
  // calorie and protein target for someone who does not know theirs.
  heightIn  Float?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// What Apple says about this account's subscription, mirrored locally.
///
/// Apple is the source of truth; this is a cache so every request does not
/// become a network call to App Store Server. It is written from two places —
/// the transaction the app posts after a purchase, and the notifications Apple
/// sends afterwards — and both carry the same fields, so whichever arrives
/// last wins.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Apple's stable identifier for this subscription, constant across
  /// renewals, upgrades and resubscribes.
  ///
  /// Deliberately not unique: Family Sharing puts the buyer's id on every
  /// family member's transaction, so several rows legitimately share one.
  /// `syncSubscription` enforces the real rule instead — at most one
  /// PURCHASED row per id — which a database constraint cannot express.
  originalTransactionId String

  /// 'PURCHASED' | 'FAMILY_SHARED'. Who this row belongs to relative to the
  /// person who paid. Apple signs it, so it can be trusted to tell a family
  /// member apart from a replayed receipt.
  ownershipType String @default("PURCHASED")

  /// The App Store product — the monthly or the annual.
  productId String

  /// Apple's own status, kept as a bare string like every other kind column
  /// here: 'active' | 'expired' | 'billing_retry' | 'grace' | 'revoked'.
  status String

  /// When access ends if nothing renews. The entitlement is this plus the
  /// clock; nothing is trusted to a status string alone, because a renewal
  /// notification that never arrives would otherwise strand a paying user.
  expiresAt DateTime

  /// True while the introductory offer is running. Recorded because a trial
  /// and a paid month are the same entitlement but not the same event.
  isTrial Boolean @default(false)

  /// 'Production' | 'Sandbox'. A sandbox transaction must never entitle a real
  /// account in production, and telling them apart after the fact is
  /// impossible without this.
  environment String

  lastVerifiedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
  /// Notifications and the collision check both look rows up by this, and it
  /// stopped being indexed when the unique constraint came off.
  @@index([originalTransactionId])
}
