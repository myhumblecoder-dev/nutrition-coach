# Copy to .env.local and fill in real values (.env.local is gitignored).
# DATABASE_URL matches the Postgres service in docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutrition_coach?schema=public"

# Auth.js (NextAuth v5) — GitHub OAuth
# Create a GitHub OAuth app (Settings > Developer settings > OAuth
# Apps), callback: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Auth.js — Google OAuth
# Create a Google Cloud OAuth client, callback: /api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auth.js — Sign in with Apple
# AUTH_APPLE_ID is the Apple Services ID string (e.g. com.example.app.web).
# The secret is a JWT generated by scripts/generate-apple-secret.mjs expiring within 6 months.
# Rotation requires a redeploy. Callback: /api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Sign in with Apple — native iOS client
# The iOS app's Bundle ID. Native ASAuthorizationController tokens carry the
# Bundle ID as their audience, NOT the Services ID above, so /api/v1/auth/apple
# verifies against this. No client secret is involved in the native flow.
AUTH_APPLE_BUNDLE_ID=""

# App Attest (iOS)
# Proves a request came from a genuine, unmodified build of the app on real
# Apple hardware, rather than from a script holding a leaked bearer token.
#
# APPLE_TEAM_ID is the same 10-character Apple Team ID as APNS_TEAM_ID below.
# It is read separately because push and attestation are independently
# optional; setting only APNS_TEAM_ID leaves attestation unconfigured, which
# 500s /api/v1/attest/challenge and — with APP_ATTEST_REQUIRED=true — fails
# every gated route. Set both to the same value.
APPLE_TEAM_ID=""

# Enforcement is opt-in. Leave empty until a client that sends assertions has
# shipped: setting this to "true" first locks out every existing user. Only
# the literal "true" enables it.
APP_ATTEST_REQUIRED=""

# Debug and simulator builds attest against Apple's development environment,
# which Apple signs with a different aaguid. Only the literal "true" accepts
# those. MUST stay empty in production — accepting development attestations
# accepts any simulator build, which defeats the entire gate.
APP_ATTEST_ALLOW_DEV=""

# Telegram
TELEGRAM_BOT_USERNAME=""

# Apple Push Notification service (iOS app)
# APNS_PRIVATE_KEY holds the .p8 contents, not a path — Vercel has no
# persistent filesystem to read a key from at request time. Escaped \n in the
# env var are unescaped at load. Create the key in the Apple Developer portal
# (Keys > Apple Push Notifications service); it downloads exactly once.
# APNS_ENVIRONMENT=sandbox targets the APNs sandbox host for TestFlight debug
# builds; anything else uses production.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""
APNS_BUNDLE_ID=""
APNS_ENVIRONMENT=""

# LLM
# LLM_PROVIDER=anthropic uses the hosted path (production); anything else falls
# back to a local Ollama. The two branches read SEPARATE model variables on
# purpose: LLM_MODEL names the hosted model, OLLAMA_MODEL the local one, and
# sharing one meant flipping providers sent a Claude model name to Ollama.
LLM_PROVIDER=""
LLM_MODEL=""
OLLAMA_BASE_URL=""
OLLAMA_MODEL=""
ANTHROPIC_API_KEY=""

# Per-user daily cap on coach messages. Each reply costs two model calls (the
# reply plus the extraction pass), so an unbounded chat is an unbounded bill.
# Defaults to 60 — roughly 2-3x a heavy real day, so ordinary use never sees
# it. A malformed value falls back to the default rather than meaning
# "unlimited".
DAILY_MESSAGE_LIMIT=""

# Per-user daily cap on photo analysis. Vision is the most expensive call in
# the app and a real day of eating is a handful of photos, so this defaults
# lower than the message cap (40). Both are counted in the UsageEvent table
# rather than inferred from rows a call happens to leave behind.
DAILY_PHOTO_LIMIT=""
